{
  "name": "marimo-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A deliberately simple Discord marimo raising bot.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "compose:check": "node scripts/check-compose-env-scope.mjs",
    "dev": "tsx watch src/app/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:samples": "tsx scripts/generate-samples.ts",
    "lint": "eslint .",
    "start": "node dist/app/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "discord.js": "^14.20.0",
    "pg": "^8.22.0",
    "pino": "^9.7.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.32",
    "@types/pg": "^8.20.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
